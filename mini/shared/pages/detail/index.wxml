<import src="../../templates/common.wxml" /><view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><block wx:if="{{property}}">
<swiper wx:if="{{gallery.length}}" class="gallery" indicator-dots><swiper-item wx:for="{{gallery}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" /></swiper-item></swiper><view wx:else class="empty">暂无房源图片</view>
<view class="title">{{property.title}}</view><view class="muted">{{property.community}} · {{property.info}}</view><view class="stats"><view><view class="price">{{property.priceLabel}}</view><view class="muted">总价</view></view><view>{{property.rooms}}<view class="muted">户型</view></view><view>{{property.area}}㎡<view class="muted">面积</view></view></view>
<view class="line"><view>地址：{{property.address || '未提供'}}</view><view class="muted">楼层：{{property.floor || '未提供'}} · 朝向：{{property.orientation || '未提供'}}</view><view class="muted">装修：{{property.decoration || '未提供'}} · 建成年份：{{property.year || '未提供'}}</view><view class="muted">浏览（演示计数）：{{property.views == null ? '未提供' : property.views}} · 状态：{{property.statusLabel}}</view><view class="muted">发布时间：{{property.createdAt}}</view><text wx:for="{{property.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
<view class="subtitle">房源介绍</view><view class="body line">{{property.description || '暂无介绍'}}</view>
<view class="actions"><button bindtap="favorite" disabled="{{busy || loading}}" loading="{{busy}}">{{favorite ? '取消收藏' : '收藏房源'}}</button><button class="secondary" open-type="share">分享</button><button wx:if="{{canBook}}" class="secondary" data-page="form" data-collection="appointments" data-property-id="{{property.id}}" bindtap="nav">预约看房</button></view>
<view class="panel"><view>VR 看房 · 待接入</view><button disabled>VR 服务不可用</button><view class="muted">未连接 VR / 门锁服务商。申请审批不代表取得开锁能力。</view><button disabled>真实开锁不可用</button><button wx:if="{{canRequestLock}}" class="secondary" data-page="form" data-collection="lockRequests" data-property-id="{{property.id}}" bindtap="nav">提交门锁授权申请（演示）</button><view wx:else class="muted">仅业主或负责经纪人可申请门锁审核。</view></view>
<view class="subtitle">交易信息</view><view wx:for="{{transactionFields}}" wx:key="key" class="line"><text class="muted">{{item.label}}　</text>{{item.value}}</view><view wx:for="{{transactions}}" wx:key="id" class="line">{{item.title}}<view class="price">{{item.price}} 万</view></view><view wx:if="{{!transactionFields.length && !transactions.length}}" class="empty">暂无交易资料</view>
<view class="subtitle">负责经纪人</view><view wx:if="{{agent.id}}">{{agent.name}}<view class="muted">{{agent.company}}</view><view class="actions"><button class="secondary" data-page="cards" data-id="{{agent.id}}" bindtap="nav">经纪人名片</button><button wx:if="{{canChat}}" data-page="form" data-collection="messages" data-to="{{agent.id}}" data-property-id="{{property.id}}" bindtap="nav">在线沟通</button><button class="secondary" data-phone="{{agent.phone}}" bindtap="call" disabled="{{!agent.phone}}">电话联系</button></view><view wx:if="{{!agent.phone}}" class="muted">演示服务未提供可拨打电话</view></view><view wx:else class="empty">暂无负责经纪人</view>
<button wx:if="{{canEdit}}" data-page="form" data-collection="properties" data-id="{{property.id}}" bindtap="nav">编辑我的房源 / 照片</button><button wx:if="{{canCollaborate}}" data-page="form" data-collection="collaborations" data-property-id="{{property.id}}" bindtap="nav">发起联卖</button><button class="secondary" data-page="form" data-collection="feedback" data-property-id="{{property.id}}" bindtap="nav">房源反馈</button><button class="secondary" data-page="form" data-collection="questions" data-property-id="{{property.id}}" bindtap="nav">咨询房源问题</button>
</block></view>
