<import src="../../templates/common.wxml" /><view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">发现好房</view><input placeholder="搜索小区、标题、区域" value="{{query}}" bindinput="search" aria-label="搜索房源" /><view class="actions"><picker class="grow" range="{{cities}}" value="{{cityIndex}}" bindchange="city"><view class="picker">{{cities[cityIndex]}}</view></picker><picker class="grow" range="{{sorts}}" value="{{sortIndex}}" bindchange="sort"><view class="picker">{{sorts[sortIndex]}}</view></picker></view><view class="muted">{{items.length || 0}} 套匹配房源 · 价格单位：万元</view><template is="rows" data="{{items}}" /></view>
