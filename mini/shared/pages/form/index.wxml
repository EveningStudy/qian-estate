<import src="../../templates/common.wxml" /><view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">{{title}}</view>
<view wx:if="{{collection === 'agent-applications'}}" class="panel">提交真实资料后等待管理员审核。提交申请不会立即变更账号角色。</view>
<view wx:for="{{fields}}" wx:key="key" class="field"><text class="label">{{item.label}}{{item.required ? ' *' : ''}}</text><textarea wx:if="{{item.type === 'textarea'}}" data-key="{{item.key}}" value="{{values[item.key]}}" bindinput="input" /><picker wx:elif="{{choices[item.type]}}" range="{{choices[item.type]}}" range-key="name" value="{{selection[item.key] || 0}}" data-key="{{item.key}}" data-type="{{item.type}}" bindchange="choose"><view class="picker">{{choices[item.type][selection[item.key] || 0].name}}</view></picker><picker wx:elif="{{item.type === 'date' || item.type === 'time'}}" mode="{{item.type}}" value="{{values[item.key]}}" data-key="{{item.key}}" bindchange="input"><view class="picker">{{values[item.key] || '请选择'}}</view></picker><input wx:else data-key="{{item.key}}" type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{values[item.key]}}" bindinput="input" /></view>
<view wx:if="{{collection === 'properties'}}"><view class="subtitle">房源照片（最多12张）</view><view class="muted">仅 PNG/JPEG，单张最多5MB。先上传，保存表单后关联房源；在售房源编辑后重新审核。</view><view wx:for="{{images}}" wx:key="url" class="inline"><image src="{{item.src}}" class="cover" mode="aspectFill" /><button data-index="{{index}}" bindtap="removePhoto" disabled="{{busy}}">移除此照片</button></view><button bindtap="photos" disabled="{{busy || images.length >= 12}}" loading="{{busy}}">选择并上传照片</button></view>
<button bindtap="submit" disabled="{{busy || loading || invalid || saved}}" loading="{{busy}}">{{saved ? '服务器已保存' : '提交到服务器'}}</button><view wx:if="{{saved}}" class="success">已保存。申请及房源审核结果请刷新工作台或个人中心查看。</view><view wx:if="{{result}}" class="success"><view>{{result.low}} — {{result.high}} {{result.unit}}</view><view>{{result.method}}</view><view>{{result.disclaimer}}</view></view></view>
