<view class="page"><import src="../../templates/common.wxml" /><template is="state" data="{{loading,error,busy,mode}}" /><view wx:if="{{agent}}"><view class="title">经纪人名片</view><view class="panel"><view class="subtitle">{{agent.name}}</view><view>{{agent.company}}</view><view>{{agent.city}} · {{agent.district}}</view><view class="muted">{{agent.bio}}</view></view><view class="line">从业 {{agent.experience}} 年 · 评分 {{agent.rating}} · 服务 {{agent.completedDeals}} 次</view><button data-phone="{{agent.phone}}" bindtap="call" disabled="{{!agent.phone}}">确认后拨打电话</button><button wx:if="{{canChat}}" class="secondary" data-page="form" data-collection="messages" data-to="{{agent.id}}" bindtap="nav">发送消息</button></view></view>
