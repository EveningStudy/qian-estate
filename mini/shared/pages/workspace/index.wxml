<import src="../../templates/common.wxml" />
<view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">业务工作台</view>
<view wx:if="{{appRole === 'agent' && role !== 'agent'}}" class="panel">经纪人权限需管理员审核通过。<button data-page="form" data-collection="agent-applications" bindtap="nav">申请经纪人入驻</button></view>
<view class="actions"><button wx:if="{{role === 'owner'}}" data-page="form" data-collection="commissions" bindtap="nav">出售委托</button><button wx:if="{{role === 'owner'}}" data-page="form" data-collection="properties" bindtap="nav">发布房源</button><button wx:if="{{role === 'agent'}}" data-page="form" data-collection="clients" bindtap="nav">添加客户</button><button wx:if="{{role === 'agent'}}" data-page="form" data-collection="collaborations" bindtap="nav">发起联卖</button></view>
<view wx:for="{{groups}}" wx:key="collection" wx:for-item="group"><view class="subtitle">{{group.title}}</view><view wx:if="{{!group.items.length}}" class="empty">暂无记录</view><view wx:for="{{group.items}}" wx:key="id" wx:for-item="record" class="line"><view>{{record.titleLabel}}</view><view class="tag">{{record.statusLabel}}</view><view class="muted">{{record.scheduledAt || record.preference || record.reason || record.note}}</view><button wx:if="{{record.propertyId}}" class="secondary" data-page="detail" data-id="{{record.propertyId}}" bindtap="nav">查看关联房源</button><view class="actions"><button wx:for="{{record.actions}}" wx:key="status" disabled="{{busy || loading}}" data-collection="{{group.collection}}" data-id="{{record.id}}" data-status="{{item.status}}" bindtap="change">{{item.label}}</button></view></view></view></view>
