<view class="page"><import src="../../templates/common.wxml" /><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">{{title}}</view><view wx:for="{{items}}" wx:key="id" class="line"><view>{{item.title || item.question}}</view><view class="body muted">{{item.content || item.answer || item.description || (item.price ? item.price + ' 万' : '')}}</view></view></view>
