<import src="../../templates/common.wxml" /><view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">消息</view><view wx:for="{{items}}" wx:key="id" class="line"><view>{{item.senderName}} → {{item.recipientName}}</view><view class="body">{{item.content}}</view><view class="muted">{{item.createdAt}} · {{item.statusLabel}}</view><button class="secondary" data-page="form" data-collection="messages" data-to="{{item.replyTo}}" data-property-id="{{item.propertyId}}" bindtap="nav">回复</button><button wx:if="{{item.canRead}}" data-id="{{item.id}}" bindtap="read" disabled="{{busy}}">标记已读</button></view><view wx:if="{{!items.length}}" class="empty">暂无消息</view><button data-page="form" data-collection="messages" bindtap="nav">选择联系人并发送</button></view>
