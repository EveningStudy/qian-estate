<import src="../../templates/common.wxml" /><view class="page"><template is="state" data="{{loading,error,busy,mode}}" /><view class="title">个人中心</view>
<block wx:if="{{!loggedIn}}"><view class="panel">登录后可管理委托、预约和消息。不会未经您的操作自动登录。</view><checkbox-group bindchange="consent"><label><checkbox value="agree" checked="{{consent}}" />我已阅读并同意隐私说明，授权微信登录</label></checkbox-group><button class="secondary" bindtap="privacy">查看微信隐私保护指引</button><button bindtap="login" disabled="{{!consent || busy}}" loading="{{busy}}">{{mode === 'demo' ? '进入显式演示账号' : '微信登录'}}</button></block>
<block wx:else><view class="panel"><view class="subtitle">{{profile.name}}</view><view>{{role === 'admin' ? '管理员' : role === 'agent' ? '经纪人' : '业主'}} · {{profile.city}}</view><view>{{profile.phone || '手机号未绑定'}}</view></view><button wx:if="{{mode === 'production'}}" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{busy}}">授权绑定微信手机号</button><button data-page="form" data-collection="profile" bindtap="nav">编辑资料</button><button wx:if="{{appRole === 'agent' && role !== 'agent'}}" data-page="form" data-collection="agent-applications" bindtap="nav">申请经纪人入驻</button><view wx:for="{{applications}}" wx:key="id" class="line"><view>{{item.company}} · {{item.statusLabel}}</view><view class="muted">{{item.note || '等待管理员审核'}}</view></view><view class="profile-menu"><view class="menu-row" data-page="workspace" bindtap="nav"><text>我的委托与看房预约</text><text class="muted">查看进度 ›</text></view><view class="menu-row" data-section="showFavorites" bindtap="toggleSection"><text>我的收藏</text><text class="muted">{{favorites.length}} 套 ›</text></view><view wx:if="{{showFavorites}}" class="subsection"><template is="rows" data="{{items:favorites}}" /></view><view class="menu-row" data-section="showProperties" bindtap="toggleSection"><text>我的房源资料</text><text class="muted">{{own.length}} 套 ›</text></view><view wx:if="{{showProperties}}" class="subsection"><template is="rows" data="{{items:own}}" /><button class="secondary" data-page="form" data-collection="properties" bindtap="nav">补充房源资料</button></view><view class="menu-row" data-section="showAgents" bindtap="toggleSection"><text>联系经纪人</text><text class="muted">选择联系人 ›</text></view><view wx:if="{{showAgents}}"><button wx:for="{{agents}}" wx:key="id" class="secondary" data-page="cards" data-id="{{item.id}}" bindtap="nav">{{item.name}} · 经纪人名片</button></view></view><button class="secondary" data-page="feed" data-collection="faqs" bindtap="nav">帮助与问答</button><button class="secondary" data-page="form" data-collection="feedback" bindtap="nav">意见反馈</button>
<view wx:if="{{mode === 'production'}}" class="menu-row" data-section="showServices" bindtap="toggleSection"><text>通知与账号设置</text><text class="muted">展开 ›</text></view><view wx:if="{{mode === 'production' && showServices}}" class="panel">
 <view class="subtitle">通知与账号服务</view>
 <view class="muted">手机号仅显示脱敏号码。入驻申请须手动填写与微信绑定一致的完整11位号码。</view>
 <button class="secondary" bindtap="prepareSubscription" disabled="{{busy}}">加载订阅模板</button>
 <button wx:if="{{templateId}}" bindtap="subscribe" disabled="{{busy}}">授权订阅业务通知</button>
 <checkbox-group bindchange="smsConsent"><label><checkbox value="sms" />同意向本人已绑定手机发送验证短信（可选）</label></checkbox-group>
 <button class="secondary" bindtap="smsChallenge" disabled="{{busy || !smsConsented}}">发送短信验证码</button>
 <view class="muted">五分钟最多一次。超时可能已受理，请勿重复发送。</view>
 <input type="number" maxlength="6" value="{{smsCode}}" bindinput="smsInput" placeholder="6位短信验证码" />
 <button class="secondary" bindtap="smsVerify" disabled="{{busy}}">验证短信</button>
 <view wx:if="{{serviceMessage}}" class="notice">{{serviceMessage}}</view>
 <block wx:if="{{role === 'admin'}}"><view class="subtitle">管理后台配对</view><button bindtap="pairing" disabled="{{busy}}">生成一次性浏览器配对码</button><view wx:if="{{pairCode}}"><text selectable>{{pairCode}}</text><view>有效至 {{pairExpiry}}，仅在自己的管理后台输入，请勿转发。</view></view></block>
</view>
<button class="secondary" bindtap="logout" disabled="{{busy}}">退出并撤销当前登录</button></block></view>
