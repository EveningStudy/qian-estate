# 供 docker compose --env-file 使用，不会自动加载到本地 Node 进程。
# 必填：微信业主小程序真实凭据；留空会拒绝部署，不要提交密钥文件。
WECHAT_OWNER_APPID=
WECHAT_OWNER_SECRET=
# 必填：联卖端微信应用真实凭据；生产环境两端均须配置。
WECHAT_AGENT_APPID=
WECHAT_AGENT_SECRET=
# 必填：有效的公开 HTTPS 站点根地址，应与证书域名和 CORS 来源一致。
PUBLIC_APP_URL=
# 必填：浏览器实际访问的 HTTPS 来源，多个用逗号分隔，不带末尾斜杠或路径。
CORS_ORIGINS=
# 可选：已创建的正式经纪人标识；不设置时创建房源需显式选择经纪人。
DEFAULT_AGENT_ID=
# 必填：宿主机证书目录绝对路径，包含 fullchain.pem 和 privkey.pem。
# Windows 示例：D:/secrets/qian-estate/certs；Linux 示例：/srv/qian-estate/certs。
TLS_CERT_DIR=
OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_VERSION=2026-09-09
WECHAT_CONTENT_CHECK=true
MINI_MODE=production
MINI_API_BASE_URL=
# Compose 固定注入 NODE_ENV=production、HOST=0.0.0.0、PORT=4310、
# DATA_DIR=/var/lib/qian-estate；不要在本文件修改这些值。
# 不需要 SESSION_SECRET。其他接入变量会通过 env_file 原样进入 API，
# 只能依据服务端对应模块的真实配置说明添加，不能用名称开关伪装成功。
# 注意：尚未配置的可选服务商变量应完全省略，不要添加空值以免触发部分配置校验。
