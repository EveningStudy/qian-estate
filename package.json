{
  "name": "qian-estate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx server/src/server.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4311",
    "build": "tsc --noEmit && vite build && npm run build:mini",
    "build:mini": "node --env-file-if-exists=.env scripts/build-mini.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:mini:demo": "node scripts/build-mini-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:api && npm run test:mini",
    "test:api": "tsx --test server/tests/*.test.ts",
    "test:mini": "node scripts/test-mini.mjs",
    "test:wxml": "node scripts/check-wxml.mjs",
    "test:deploy": "tsx --test deploy/config.test.ts",
    "check:production": "node --env-file-if-exists=deploy/.env.production --import tsx scripts/check-production.ts",
    "backup": "node scripts/backup.mjs",
    "account:role": "node --env-file-if-exists=.env --import tsx scripts/set-role.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write web server mini scripts docs *.json *.ts *.md",
    "format:check": "prettier --check web server mini scripts docs *.json *.ts *.md",
    "start": "node --env-file-if-exists=.env --import tsx server/src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
