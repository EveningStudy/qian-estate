# 复制为 .env；开发命令自动读取，真实密钥不得进入交接包或源码仓库。
NODE_ENV=development
PORT=4310
HOST=127.0.0.1
MINI_MODE=demo
MINI_API_BASE_URL=http://localhost:4310
PRIVACY_VERSION=2026-09-09
# 微信联调时填两组凭据，并改 MINI_MODE=production 与公开 HTTPS 地址。
# WECHAT_OWNER_APPID=
# WECHAT_OWNER_SECRET=
# WECHAT_AGENT_APPID=
# WECHAT_AGENT_SECRET=
# WECHAT_CONTENT_CHECK=true
# OPERATOR_NAME=
# SUPPORT_EMAIL=
# PUBLIC_APP_URL=https://你的域名
# CORS_ORIGINS=https://你的域名
# DATA_DIR=D:/PrivateData/qian-estate
# DEFAULT_AGENT_ID=正式经纪人编号
# BACKUP_DIR=D:/PrivateBackups/qian-estate
# 地图使用服务端密钥，设置供应商出口地址白名单。
# TENCENT_MAP_KEY=
# 短信只使用一个参数的验证码模板。
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou
# 订阅消息使用单个标题字段的模板，其他模板需扩展字段映射。
# WECHAT_SUBSCRIBE_TEMPLATE_ID=
# WECHAT_SUBSCRIBE_TITLE_FIELD=thing1
# 不填时使用本地持久卷，填写时必须成组，存储桶必须私有。
# S3_ENDPOINT=https://对象存储端点
# S3_REGION=ap-southeast-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# 支付仅有签名验签工具，没有收款订单业务，不要据此开启收款。
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PEM=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=
# WECHAT_PAY_PLATFORM_PUBLIC_KEYS_JSON=
